{
    "name": "erikwang2013/bigdata-php",
    "description": "Unified PHP clients for big-data platforms with optional drivers: Trino, Hadoop, Hive, Spark, Flink, Doris, StarRocks, Kylin, Druid, Iceberg, Hudi, Paimon, Delta Lake, DolphinScheduler, Airflow, Azkaban, Oozie, HBase, Cassandra.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "bigdata",
        "trino",
        "hadoop",
        "hive",
        "spark",
        "flink",
        "doris",
        "starrocks",
        "kylin",
        "druid",
        "iceberg",
        "hudi",
        "paimon",
        "delta-lake",
        "dolphinscheduler",
        "airflow",
        "azkaban",
        "oozie",
        "hbase",
        "cassandra"
    ],
    "authors": [
        {
            "name": "erik",
            "email": "erik@erik.xyz"
        }
    ],
    "require": {
        "php": ">=8.0",
        "guzzlehttp/guzzle": "^7.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "apache/thrift": "^0.24 || ^0.25",
        "mroosz/php-cassandra": "^1.2",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6 || ^10.5"
    },
    "suggest": {
        "ext-pdo_mysql": "Required for Doris/StarRocks SQL; Stream Load works without it.",
        "apache/thrift": "Required for the Hive / Spark Thrift Server driver.",
        "mroosz/php-cassandra": "Required for the Cassandra driver.",
        "aws/aws-sdk-php": "Optional S3 storage for the Hudi and Paimon drivers."
    },
    "autoload": {
        "psr-4": {
            "Erikwang2013\\BigData\\": "src/"
        },
        "classmap": [
            "src/Driver/Hive/Thrift/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Erikwang2013\\BigData\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test-integration": "phpunit --testsuite integration"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Erikwang2013\\BigData\\Integration\\Laravel\\BigDataServiceProvider"
            ]
        },
        "hyperf": {
            "config": "Erikwang2013\\BigData\\Integration\\Hyperf\\ConfigProvider"
        },
        "think": {
            "services": [
                "Erikwang2013\\BigData\\Integration\\ThinkPHP\\BigDataService"
            ]
        },
        "config-plugin-options": {
            "source-directory": "config"
        },
        "config-plugin": {
            "params": "params.php",
            "di": "di.php"
        }
    },
    "homepage": "https://github.com/erikwang2013/bigdata-php",
    "support": {
        "issues": "https://github.com/erikwang2013/bigdata-php/issues",
        "source": "https://github.com/erikwang2013/bigdata-php"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
